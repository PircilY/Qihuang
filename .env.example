# Java service
SERVER_PORT=8080
RAG_PORT=8000
RAG_ENGINE_MODE=auto
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_FALLBACK_TO_LOCAL=true
RAG_CONNECT_TIMEOUT=500ms
RAG_READ_TIMEOUT=30s
RAG_RETRY_INTERVAL=10s

# Native launch only; Compose uses its own container address and persistent volume.
# Export these values in the launching shell; java/uvicorn do not auto-load .env.
# SERVER_ADDRESS=127.0.0.1
# KNOWLEDGE_STORE_PATH=./runtime/knowledge-imports.json

# RAG workbench generation (Java, no extra Python dependency).
# Secrets are not committed; prefer a secret manager or process environment.
# MODEL_API_BASE=https://api.deepseek.com/v1
# MODEL_NAME=the-model-id-returned-by-your-provider
# MODEL_API_KEY=
# MODEL_TIMEOUT=60s
# MODEL_ALLOWED_BASE_URLS=https://api.deepseek.com/v1,https://api.deepseek.com,https://dashscope.aliyuncs.com/compatible-mode/v1,https://api.openai.com/v1

# Legacy Python direct API generation (not used by the workbench chat endpoint).
# INSTALL_LLM=true
# LLM_API_BASE=https://your-endpoint.example/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=your-model

# Optional Docker registry mirror images (use when Docker Hub is unreachable)
# PYTHON_IMAGE=python:3.12-slim
# MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17
# JAVA_IMAGE=eclipse-temurin:17-jre
