# Java service
RAG_ENGINE_MODE=auto
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_FALLBACK_TO_LOCAL=true
RAG_CONNECT_TIMEOUT=500ms
RAG_READ_TIMEOUT=30s

# Optional OpenAI-compatible generation model
# LLM_API_BASE=https://your-endpoint.example/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=your-model

# Optional Docker registry mirror images (use when Docker Hub is unreachable)
# PYTHON_IMAGE=python:3.12-slim
# MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17
# JAVA_IMAGE=eclipse-temurin:17-jre
