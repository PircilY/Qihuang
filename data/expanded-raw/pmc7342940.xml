" corresp="yes"><name-alternatives><name name-style="eastern"><surname>高</surname><given-names initials="春记">春记</given-names></name><name xml:lang="en" name-style="western"><surname>Gao</surname><given-names initials="C">Chunji</given-names></name></name-alternatives></contrib></contrib-group><aff id="aff1"><addr-line>100853 北京，解放军总医院血液科</addr-line><addr-line xml:lang="en">Department of Hematology, Chinese PLA General Hospital, Beijing 100853, China</addr-line></aff><contrib-group><contrib contrib-type="editor"><name name-style="eastern"><surname>徐</surname><given-names initials="茂强">茂强</given-names></name></contrib></contrib-group><author-notes><corresp id="cor1">通信作者：高春记(Gao Chunji)，Email：<email>gaochunji@hotmail.com</email></corresp></author-notes><pub-date pub-type="ppub"><month>3</month><year>2016</year></pub-date><volume>37</volume><issue>3</issue><issue-id pub-id-type="pmc-issue-id">361033</issue-id><fpage>258</fpage><lpage>261</lpage><history><date date-type="received"><day>11</day><month>9</month><year>2015</year></date></history><pub-history><event event-type="pmc-release"><date><day>01</day><month>03</month><year>2016</year></date></event><event event-type="pmc-live"><date><day>16</day><month>07</month><year>2020</year></date></event><event event-type="pmc-last-change"><date iso-8601-date="2026-09-10 14:31:23.613"><day>10</day><month>09</month><year>2026</year></date></event></pub-history><permissions><copyright-statement>2016年版权归中华医学会所有</copyright-statement><copyright-statement xml:lang="en">Copyright © 2016 by Chinese Medical Association</copyright-statement><copyright-year>2016</copyright-year><license xmlns:xlink="http://www.w3.org/1999/xlink" license-type="open-access" xlink:href="http://creativecommons.org/licenses/by-nc-sa/3.0/"><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncsalicense">https://creativecommons.org/licenses/by-nc-sa/3.0/</ali:license_ref><license-p>This work is licensed