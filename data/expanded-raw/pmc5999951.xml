<article article-type="research-article" xml:lang="zh" dtd-version="1.4"><front><journal-meta><journal-id journal-id-type="nlm-ta">Zhongguo Fei Ai Za Zhi</journal-id><journal-id journal-id-type="iso-abbrev">Zhongguo Fei Ai Za Zhi</journal-id><journal-id journal-id-type="pmc-domain-id">3417</journal-id><journal-id journal-id-type="pmc-domain">cjlc</journal-id><journal-id journal-id-type="nlm-id">101126433</journal-id><journal-id journal-id-type="publisher-id">ZGFAZZ</journal-id><journal-title-group><journal-title>Chinese Journal of Lung Cancer</journal-title></journal-title-group><issn pub-type="ppub">1009-3419</issn><issn pub-type="epub">1999-6187</issn><?publisher_abbrev eocjlc?><publisher><publisher-name>Editorial office of Chinese Journal of Lung Cancer</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC5999951</article-id><article-id pub-id-type="pmcid-ver">PMC5999951.1</article-id><article-id pub-id-type="pmcaid">5999951</article-id><article-id pub-id-type="pmcaiid">5999951</article-id><article-id pub-id-type="pmid">22901995</article-id><article-id pub-id-type="doi">10.3779/j.issn.1009-3419.2012.08.04</article-id><article-id pub-id-type="publisher-id">zgfazz-15-8-471</article-id><article-id pub-id-type="other">R734.2</article-id><article-version article-version-type="pmc-version">1</article-version><article-categories><subj-group subj-group-type="heading"><subject>临床研究</subject></subj-group><subj-group subj-group-type="toc-heading" xml:lang="en"><subject>Clinical Research</subject></subj-group></article-categories><title-group><article-title>1.5T MRI评估肺动脉高压患者右心功能及肺动脉血液动力学</article-title><trans-title-group xml:lang="en"><trans-title xml:lang="en">The Assessment of Right Ventricular Function and Pulmonary Artery Hemodynamics in Patients with Pulmonary Hypertension by 1.5T MRI</trans-title></trans-title-group></title-group><contrib-group><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>韩</surname><given-names initials="艳">艳</given-names></name><name xml:lang="en" name-style="western"><surname>HAN</surname><given-names initials="Y">Yan</given-names></name></name-alternatives><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>杨</surname><given-names initials="振文">振文</given-names></name><name xml:lang="en" name-style="western"><surname>YANG</surname><given-names initials="Z">Zhenwen</given-names></name></name-alternatives><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>于</surname><given-names initials="铁链">铁链</given-names></name><name xml:lang="en" name-style="western"><surname>YU</surname><given-names initials="T">Tielian</given-names></name></name-alternatives><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>于</surname><given-names initials="静">静</given-names></name><name xml:lang="en" name-style="western"><surname>YU</surname><given-names initials="J">Jing</given-names></name></name-alternatives><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>薛</surname><given-names initials="米娜">米娜</given-names></name><name xml:lang="en" name-style="western"><surname>XUE</surname><given-names initials="M">Mina</given-names></name></name-alternatives><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>张</surname><given-names initials="璋">璋</given-names></name><name xml:lang="en" name-style="western"><surname>ZHANG</surname><given-names initials="Z">Zhang</given-names></name></name-alternatives><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib contrib-type="author"><name-alternatives><name name-style="eastern"><surname>李</surname><gi